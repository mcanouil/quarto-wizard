{
	"name": "explorer-view-context",
	"frame": ["activitybar", "sidebar", "contextmenu"],
	"steps": [
		{
			"kind": "setVersion",
			"extension": "mcanouil/iconify",
			"version": "4.0.0"
		},
		{
			"kind": "command",
			"title": "Quarto Wizard: Focus on Extensions Installed View"
		},
		{
			"kind": "wait",
			"text": "Updates checked against",
			"timeout": 60000
		},
		{
			"kind": "click",
			"text": "Detected Projects",
			"part": "sidebar"
		},
		{
			"kind": "sidebarWidth",
			"width": 500
		},
		{
			"kind": "click",
			"text": "mcanouil/iconify",
			"part": "sidebar",
			"button": "right"
		}
	]
}
