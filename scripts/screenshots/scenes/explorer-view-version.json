{
	"name": "explorer-view-version",
	"frame": ["activitybar", "sidebar"],
	"steps": [
		{
			"kind": "setVersion",
			"extension": "mcanouil/iconify",
			"version": "4.0.0"
		},
		{
			"kind": "write",
			"file": "_extensions/demo/legacy/_extension.yml",
			"content": "title: Legacy\nauthor: Demo\nversion: 1.0.0\nquarto-required: \">=100.0.0\"\ncontributes:\n  filters:\n    - legacy.lua\n"
		},
		{
			"kind": "write",
			"file": "_extensions/demo/legacy/legacy.lua",
			"content": "return {}\n"
		},
		{
			"kind": "command",
			"title": "Quarto Wizard: Focus on Extensions Installed View"
		},
		{
			"kind": "wait",
			"text": "Updates checked against",
			"timeout": 60000
		},
		{
			"kind": "sidebarWidth",
			"width": 500
		},
		{
			"kind": "expand",
			"row": "demo/legacy"
		}
	]
}
